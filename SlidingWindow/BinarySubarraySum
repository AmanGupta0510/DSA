    public int numSubarraysWithSum(int[] nums, int goal) {

        
       
      int x = getAtmost(nums,goal) ;
      int y = getAtmost(nums,goal-1);
      System.out.println(x+" "+y);
      return x-y;


    }
    private int getAtmost(int[] nums,int k){
        if(k<0)return 0;
        int left = 0;
        int right = 0;
        int count = 0;
        int sum = 0;
        while(right<nums.length){
            sum+=nums[right];
            while(sum>k){
                sum-=nums[left];
                left++;
            } 
            count+=right-left+1;
            right++;
        } 
        return count;
    }
}

